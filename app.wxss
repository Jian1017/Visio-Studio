/**
 * Visio Studio 拼豆工坊 - 全局暗黑极光玻璃化设计系统 (WeChat WXSS)
 */

/* ==========================================================================
   1. 设计变量与基础重置
   ========================================================================== */
page {
  /* 基础背景色 */
  --bg-dark: #0b0c10;
  --bg-darker: #050608;
  --bg-card: rgba(20, 22, 30, 0.65);
  
  /* 极光品牌色 */
  --color-purple: #8a2be2;
  --color-purple-glow: rgba(138, 43, 226, 0.4);
  --color-teal: #00f2fe;
  --color-teal-glow: rgba(0, 242, 254, 0.3);
  --color-pink: #ff007f;
  --color-pink-glow: rgba(255, 0, 127, 0.35);
  
  /* 功能状态色 */
  --color-success: #00e676;
  --color-warning: #ffb300;
  --color-error: #ff1744;
  
  /* 文字色彩 */
  --text-primary: #ffffff;
  --text-secondary: rgba(255, 255, 255, 0.7);
  --text-muted: rgba(255, 255, 255, 0.45);
  --text-dark: #121212;

  /* 边框与阴影 */
  --border-glass: rgba(255, 255, 255, 0.08);
  --border-glass-glow: rgba(0, 242, 254, 0.15);
  --shadow-glass: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  --shadow-glow: 0 0 15px rgba(0, 242, 254, 0.25);

  background-color: var(--bg-dark);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
}

view, scroll-view, text, image, button, input, textarea, canvas {
  box-sizing: border-box;
}

/* ==========================================================================
   2. 极光背景与全局布局
   ========================================================================== */
.app-container {
  min-height: 100vh;
  position: relative;
  background-color: var(--bg-dark);
  overflow-x: hidden;
  padding-bottom: 60rpx;
}

/* 霓虹极光背景光源点 */
.app-container::before {
  content: "";
  position: absolute;
  top: -10%;
  left: -20%;
  width: 80%;
  height: 600rpx;
  background: radial-gradient(circle, var(--color-purple-glow) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
  filter: blur(80px);
}

.app-container::after {
  content: "";
  position: absolute;
  bottom: 10%;
  right: -20%;
  width: 80%;
  height: 700rpx;
  background: radial-gradient(circle, var(--color-teal-glow) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
  filter: blur(100px);
}

/* 全局内容包装器（防止被极光背景遮挡） */
.app-content {
  position: relative;
  z-index: 1;
  width: 100%;
}

/* ==========================================================================
   3. 极炫玻璃拟态样式 (Glassmorphism)
   ========================================================================== */
.glass-card {
  background: var(--bg-card);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-glass);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.glass-card-hover {
  border-color: rgba(0, 242, 254, 0.3);
  box-shadow: 0 8px 32px 0 rgba(0, 242, 254, 0.1);
  transform: translateY(-2rpx);
}

.glass-panel {
  background: rgba(10, 11, 15, 0.85);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border-top: 1px solid var(--border-glass);
  box-shadow: 0 -8px 32px 0 rgba(0, 0, 0, 0.5);
}

/* ==========================================================================
   4. 炫酷渐变按钮与标签
   ========================================================================== */
.btn-gradient {
  background: linear-gradient(135deg, var(--color-purple) 0%, #6a0dad 50%, var(--color-teal) 100%);
  color: var(--text-primary);
  font-weight: 600;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  box-shadow: 0 4px 15px rgba(138, 43, 226, 0.4);
  transition: all 0.2s ease;
  display: flex;
  justify-content: center;
  align-items: center;
  border: none;
}

.btn-gradient-hover {
  opacity: 0.9;
  box-shadow: 0 6px 20px rgba(0, 242, 254, 0.5);
  transform: scale(0.98);
}

.btn-teal {
  background: linear-gradient(135deg, #00c6ff 0%, var(--color-teal) 100%);
  color: var(--text-dark);
  font-weight: 600;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  box-shadow: var(--shadow-glow);
  display: flex;
  justify-content: center;
  align-items: center;
  border: none;
}

.btn-teal-hover {
  opacity: 0.95;
  box-shadow: 0 8px 25px rgba(0, 242, 254, 0.6);
  transform: scale(0.98);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--border-glass);
  color: var(--text-secondary);
  font-weight: 500;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-secondary-hover {
  background: rgba(255, 255, 255, 0.15);
  color: var(--text-primary);
}

/* ==========================================================================
   5. 通用辅助类 (Utility Classes)
   ========================================================================== */
/* 自定义炫彩状态栏与标题栏容器 */
.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: rgba(11, 12, 16, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-glass);
}

.header-content {
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  position: relative;
}

.header-back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border-glass);
  border-radius: 50%;
  margin-right: 16rpx;
}

.header-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid var(--text-primary);
  border-bottom: 4rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  background: linear-gradient(90deg, #ffffff 0%, var(--color-teal) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 渐变标题文本 */
.title-gradient {
  background: linear-gradient(135deg, #ffffff 0%, var(--color-teal) 60%, var(--color-purple) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 800;
}

/* 滚动条隐藏 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

/* 暗色阴影发光字 */
.glow-text-teal {
  text-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
}

.glow-text-purple {
  text-shadow: 0 0 10px rgba(138, 43, 226, 0.5);
}

.glow-text-pink {
  text-shadow: 0 0 10px rgba(255, 0, 127, 0.5);
}

/* 单行文本截断 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
