/**
 * Visio Studio 拼豆工坊 - 首页专属样式 (WXSS)
 */

.welcome-section {
  padding: 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
}

.brand-badge {
  background: rgba(0, 242, 254, 0.15);
  color: var(--color-teal);
  border: 1px solid rgba(0, 242, 254, 0.3);
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 0 10px rgba(0, 242, 254, 0.1);
}

.studio-logo {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.logo-main {
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  background: linear-gradient(135deg, #ffffff 0%, #a67cff 50%, var(--color-teal) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 4px 20px rgba(138, 43, 226, 0.15);
}

.logo-sub {
  font-size: 32rpx;
  font-weight: 300;
  letter-spacing: 12rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  margin-top: -6rpx;
  padding-left: 6rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  max-width: 90%;
}

/* ==========================================================================
   功能卡片区
   ========================================================================== */
.card-grid {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
  margin-bottom: 40rpx;
}

.menu-card {
  position: relative;
  overflow: hidden;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 卡片角落发光装饰 */
.card-glow-dot {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  filter: blur(15px);
  opacity: 0.6;
}

.pink-glow {
  background: var(--color-pink);
}

.teal-glow {
  background: var(--color-teal);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.pink-bg {
  background: rgba(255, 0, 127, 0.12);
  border: 1px solid rgba(255, 0, 127, 0.3);
}

.teal-bg {
  background: rgba(0, 242, 254, 0.12);
  border: 1px solid rgba(0, 242, 254, 0.3);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid rgba(255, 255, 255, 0.04);
  padding-top: 24rpx;
}

.footer-action {
  font-size: 26rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.arrow-right {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid var(--text-primary);
  border-right: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
}

.pink-arrow {
  border-color: var(--color-pink);
}

.teal-arrow {
  border-color: var(--color-teal);
}

/* ==========================================================================
   纯 CSS 自定义图标
   ========================================================================== */
.icon-convert {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.icon-convert::before, .icon-convert::after {
  content: "";
  position: absolute;
  border: 4rpx solid var(--color-pink);
  border-radius: 50%;
}

.icon-convert::before {
  top: 0;
  left: 0;
  width: 18rpx;
  height: 18rpx;
}

.icon-convert::after {
  bottom: 0;
  right: 0;
  width: 18rpx;
  height: 18rpx;
}

.icon-palette {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid var(--color-teal);
  border-radius: 50% 50% 50% 20rpx;
  position: relative;
  transform: rotate(-15deg);
}

.icon-palette::before {
  content: "";
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--color-teal);
  box-shadow: 10rpx -4rpx 0 var(--color-teal), 2rpx 10rpx 0 var(--color-teal);
  top: 6rpx;
  left: 8rpx;
}

/* ==========================================================================
   底部说明板块
   ========================================================================== */
.info-section {
  margin: 0 40rpx 60rpx 40rpx;
  background: rgba(10, 11, 15, 0.4);
}

.info-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-teal);
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  padding-bottom: 30rpx;
  margin-bottom: 30rpx;
}

.info-step {
  display: flex;
  align-items: flex-start;
}

.step-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 242, 254, 0.1);
  border: 1px solid rgba(0, 242, 254, 0.3);
  color: var(--color-teal);
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.step-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.studio-intro {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.studio-intro text:first-child {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.studio-subtext {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.5;
}
