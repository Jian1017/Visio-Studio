/**
 * Visio Studio 拼豆工坊 - 图纸转换器专属样式 (WXSS)
 */

.preview-section {
  padding: 0 40rpx;
  margin-bottom: 36rpx;
}

/* 上传触发框 */
.upload-trigger {
  height: 460rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2px dashed rgba(0, 242, 254, 0.2);
  background: rgba(20, 22, 30, 0.4);
  gap: 20rpx;
  transition: all 0.3s ease;
}

.upload-trigger:active {
  border-color: var(--color-teal);
  background: rgba(0, 242, 254, 0.05);
}

.upload-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(0, 242, 254, 0.1);
  border: 1px solid rgba(0, 242, 254, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow);
}

.icon-camera {
  width: 48rpx;
  height: 36rpx;
  border: 4rpx solid var(--color-teal);
  border-radius: 6rpx;
  position: relative;
}

.icon-camera::before {
  content: "";
  position: absolute;
  top: -10rpx;
  left: 12rpx;
  width: 16rpx;
  height: 6rpx;
  background: var(--color-teal);
  border-radius: 2rpx 2rpx 0 0;
}

.icon-camera::after {
  content: "";
  position: absolute;
  top: 6rpx;
  left: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid var(--color-teal);
  border-radius: 50%;
}

.upload-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.upload-subtitle {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 像素图纸预览板 */
.pixel-preview-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: rgba(20, 22, 30, 0.8);
}

.canvas-wrap {
  position: relative;
  width: 300px;
  height: 300px;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid var(--border-glass);
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  background: #050608;
}

.preview-canvas {
  width: 300px;
  height: 300px;
}

/* 画布加载中蒙层 */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(11, 12, 16, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  z-index: 10;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(0, 242, 254, 0.1);
  border-left-color: var(--color-teal);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  box-shadow: var(--shadow-glow);
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-overlay text {
  font-size: 24rpx;
  color: var(--color-teal);
  letter-spacing: 1rpx;
  text-shadow: 0 0 10px rgba(0, 242, 254, 0.3);
}

.preview-actions {
  margin-top: 30rpx;
  width: 100%;
  display: flex;
  justify-content: center;
}

.action-btn-sm {
  padding: 12rpx 36rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-glass);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.action-btn-sm:active {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-primary);
}

/* ==========================================================================
   参数控制板块
   ========================================================================== */
.control-panel {
  margin: 0 40rpx 36rpx 40rpx;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.panel-section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
  border-left: 6rpx solid var(--color-teal);
  padding-left: 16rpx;
  letter-spacing: 1rpx;
}

.control-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.control-label-wrap {
  display: flex;
  align-items: baseline;
}

.item-title {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-secondary);
}

.item-subtitle {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-left: 10rpx;
}

/* 分段选项卡 */
.segment-control {
  display: flex;
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid var(--border-glass);
  border-radius: 20rpx;
  padding: 6rpx;
  width: 100%;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--text-secondary);
  border-radius: 14rpx;
  transition: all 0.2s ease;
}

.active-segment {
  background: linear-gradient(135deg, var(--color-purple) 0%, var(--color-teal) 100%);
  color: var(--text-primary);
  font-weight: bold;
  box-shadow: 0 4px 10px rgba(0, 242, 254, 0.15);
}

/* 针对多色分段选项卡的微调 */
.colors-segment .segment-item {
  font-size: 22rpx;
}

/* ==========================================================================
   统计预估板块
   ========================================================================== */
.stats-panel {
  margin: 0 40rpx 160rpx 40rpx;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-box {
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  padding: 24rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
}

.stat-label {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 所需色号速览 */
.color-list-preview {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: bold;
}

.color-bubbles-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.color-bubble {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.3);
  position: relative;
  box-shadow: 0 4px 8px rgba(0,0,0,0.3);
}

.bubble-symbol {
  font-size: 22rpx;
  font-weight: 900;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8), 0 0 2rpx rgba(0,0,0,1);
}

/* 简易悬浮提示 */
.bubble-tooltip {
  display: none;
}

/* ==========================================================================
   底部固定行动条
   ========================================================================== */
.bottom-action-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30rpx 40rpx 50rpx 40rpx;
  background: rgba(11, 12, 16, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid var(--border-glass);
  z-index: 99;
  box-shadow: 0 -10px 30px rgba(0,0,0,0.5);
}

.btn-generate {
  width: 100%;
  height: 90rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  border-radius: 46rpx;
  box-shadow: 0 0 20px rgba(0, 242, 254, 0.35);
}
