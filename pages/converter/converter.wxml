<!-- Visio Studio 拼豆工坊 - 图纸转换器 -->
<view class="app-container">
  <!-- 自定义毛玻璃头部 -->
  <view class="custom-header" style="height: {{statusBarHeight + navBarHeight}}px;">
    <view class="header-content" style="margin-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
      <view class="header-back-btn" bindtap="goBack" hover-class="btn-secondary-hover">
        <view class="header-back-icon"></view>
      </view>
      <text class="header-title">智能图纸转换</text>
    </view>
  </view>

  <!-- 隐藏的运算画布：专门用来获取缩小图片的 ImageData -->
  <canvas type="2d" id="pixelCanvas" style="width: 100px; height: 100px; position: absolute; left: -9999rpx; top: -9999rpx; pointer-events: none;"></canvas>

  <scroll-view scroll-y class="app-content" style="padding-top: {{statusBarHeight + navBarHeight + 20}}px;">
    <!-- 1. 核心图片上传与预览区 -->
    <view class="preview-section">
      <!-- 状态 A：尚未上传图片 -->
      <view class="upload-trigger glass-card" hover-class="glass-card-hover" bindtap="selectImage" wx:if="{{!imagePath}}">
        <view class="upload-icon-wrap">
          <view class="icon-camera"></view>
        </view>
        <text class="upload-title">上传您的图片/兽设</text>
        <text class="upload-subtitle">支持手机拍照、相册导入设定图</text>
      </view>

      <!-- 状态 B：已上传图片，展示 3D 拼豆效果图 -->
      <view class="pixel-preview-panel glass-card" wx:else>
        <!-- 仿真拼豆效果画布 -->
        <view class="canvas-wrap">
          <canvas type="2d" id="previewCanvas" class="preview-canvas"></canvas>
          <!-- 图片加载中蒙层 -->
          <view class="loading-overlay" wx:if="{{isProcessing}}">
            <view class="spinner"></view>
            <text>正在生成像素图纸...</text>
          </view>
        </view>

        <view class="preview-actions">
          <view class="action-btn-sm" bindtap="selectImage">
            <text>重新上传</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 2. 图纸核心控制参数调节区 -->
    <view class="control-panel glass-card" wx:if="{{imagePath}}">
      <view class="panel-section-title">🛠️ 图纸规格调校</view>

      <!-- 选项：网格规格 -->
      <view class="control-item">
        <view class="control-label-wrap">
          <text class="item-title">网格大小</text>
          <text class="item-subtitle">（决定最终拼豆成品的物理尺寸）</text>
        </view>
        <view class="segment-control">
          <view 
            wx:for="{{gridSizeOptions}}" 
            wx:key="value" 
            class="segment-item {{gridSize === item.value ? 'active-segment' : ''}}" 
            bindtap="onGridSizeChange" 
            data-value="{{item.value}}"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 选项：色彩模式 -->
      <view class="control-item">
        <view class="control-label-wrap">
          <text class="item-title">色彩模式</text>
          <text class="item-subtitle">（选择常规多彩映射，或酷炫黑白双色像素画）</text>
        </view>
        <view class="segment-control">
          <view 
            class="segment-item {{colorMode === 'color' ? 'active-segment' : ''}}" 
            bindtap="onColorModeChange" 
            data-value="color"
          >
            <text>多彩色映射</text>
          </view>
          <view 
            class="segment-item {{colorMode === 'bw' ? 'active-segment' : ''}}" 
            bindtap="onColorModeChange" 
            data-value="bw"
          >
            <text>黑白双色</text>
          </view>
        </view>
      </view>

      <!-- 选项：最大色数 -->
      <view class="control-item" wx:if="{{colorMode === 'color'}}">
        <view class="control-label-wrap">
          <text class="item-title">色数上限</text>
          <text class="item-subtitle">（智能归纳相近毛色，帮您节省购豆成本）</text>
        </view>
        <view class="segment-control colors-segment">
          <view 
            wx:for="{{maxColorsOptions}}" 
            wx:key="value" 
            class="segment-item {{maxColors === item.value ? 'active-segment' : ''}}" 
            bindtap="onMaxColorsChange" 
            data-value="{{item.value}}"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 选项：对比度/清晰度 -->
      <view class="control-item">
        <view class="control-label-wrap">
          <text class="item-title">对比度/清晰度</text>
          <text class="item-subtitle">（文字、Logo、线稿强烈建议调高，照片建议保留原图）</text>
        </view>
        <view class="segment-control">
          <view 
            wx:for="{{contrastOptions}}" 
            wx:key="value" 
            class="segment-item {{contrast === item.value ? 'active-segment' : ''}}" 
            bindtap="onContrastChange" 
            data-value="{{item.value}}"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 3. 数据预览与用料概览 -->
    <view class="stats-panel glass-card" wx:if="{{hasResult && !isProcessing}}">
      <view class="panel-section-title">📊 拼豆用量预估</view>
      <view class="stats-grid">
        <view class="stat-box">
          <text class="stat-num glow-text-teal">{{totalBeads}}</text>
          <text class="stat-label">豆子总数 (颗)</text>
        </view>
        <view class="stat-box">
          <text class="stat-num glow-text-purple">{{uniqueColorCount}}</text>
          <text class="stat-label">所需色号 (种)</text>
        </view>
        <view class="stat-box">
          <text class="stat-num glow-text-pink">{{gridSize}}x{{gridSize}}</text>
          <text class="stat-label">图纸尺寸</text>
        </view>
      </view>

      <!-- 快捷色卡清单预览 -->
      <view class="color-list-preview">
        <text class="preview-title">所需色号速览：</text>
        <view class="color-bubbles-wrap">
          <view 
            class="color-bubble" 
            wx:for="{{beadCounts}}" 
            wx:key="code" 
            style="background-color: {{item.hex}};"
            title="{{item.name}}"
          >
            <text class="bubble-symbol">{{item.symbol}}</text>
            <text class="bubble-tooltip">{{item.code}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 4. 固定的操作生成按钮 -->
    <view class="bottom-action-panel" wx:if="{{hasResult && !isProcessing}}">
      <button class="btn-teal btn-generate" hover-class="btn-teal-hover" bindtap="generatePattern">
        进入智能临摹与完整用料单
      </button>
    </view>
  </scroll-view>
</view>
